              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "const err = pm.response.json();",
                  "pm.test(\"Erreurs par champ\", () => pm.expect(err.fieldErrors).to.have.all.keys(\"name\", \"price\", \"quantity\"));"
