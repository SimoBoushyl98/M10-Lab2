    {
      "name": "2. Exercice 1 - Recherche par nom",
      "description": "GET /api/products/search?name=...",
      "item": [
        {
          "name": "Rechercher 'laptop'",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Au moins un résultat\", () => pm.expect(res.length).to.be.above(0));",
                  "pm.test(\"Tous les noms contiennent 'laptop'\", () => res.forEach(p => pm.expect(p.name.toLowerCase()).to.include(\"laptop\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/search?name=laptop",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "laptop"
                }
              ]
            },
            "description": "Recherche insensible à la casse."
          },
          "response": []
        },
        {
          "name": "Recherche sans résultat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Liste vide\", () => pm.expect(pm.response.json()).to.be.an(\"array\").that.is.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/search?name=xyz123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "xyz123"
                }
              ]
            },
            "description": "Retourne une liste vide."
          },
          "response": []
        },
        {
          "name": "Recherche sans paramètre (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "search"
              ]
            },
            "description": "Paramètre name manquant."
          },
          "response": []
        }
      ]
    },
